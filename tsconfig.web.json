{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "outDir": "./out/renderer",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "sourceMap": false,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/index.ts",
    "src/shared/**/*"
  ]
}
