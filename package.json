{
  "name": "captv",
  "version": "1.0.2",
  "packageManager": "pnpm@12.18.0",
  "description": "Capture card TV viewer with remote control support",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n main,preload,renderer,types,electron -c blue,green,yellow,magenta,red \"pnpm dev:main\" \"pnpm dev:preload\" \"pnpm dev:renderer\" \"pnpm dev:types\" \"pnpm dev:electron\"",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "dev:preload": "webpack --config webpack.preload.config.js --mode development --watch",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:types": "tsc -b --noEmit --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:3000 file:dist/main/index.js file:dist/preload/index.js && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 ELECTRON_ENABLE_LOGGING=1 electron .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "pnpm typecheck && webpack --config webpack.main.config.js --mode production && webpack --config webpack.preload.config.js --mode production && webpack --config webpack.renderer.config.js --mode production",
    "package": "pnpm build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "preversion": "pnpm build && pnpm test",
    "release": "gh workflow run release.yml --ref master -f bump=patch"
  },
  "build": {
    "appId": "com.github.jglanz.captv",
    "productName": "CapTV",
    "copyright": "Copyright © 2026 Jonathan Glanz",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/app/icons",
        "to": "icons",
        "filter": [
          "linux/512x512.png",
          "win/icon.ico"
        ]
      }
    ],
    "linux": {
      "category": "AudioVideo",
      "icon": "assets/app/icons/linux"
    },
    "win": {
      "icon": "assets/app/icons/win/icon.ico"
    },
    "mac": {
      "icon": "assets/app/icons/macos/icon.icns"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-window-state": "^5.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.10.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
